# Host paths mounted into the API container. Do not commit a filled .env.
# Copy this file to .env and point at your existing index and photo folder.
# The corpus embeddings are reused; indexing is optional.

# Directory that contains index.sqlite3 (often %USERPROFILE%\.face_search)
FACE_SEARCH_DIR=C:\Users\me\.face_search

# Indexed photo collection
PHOTO_ROOT=C:\Users\me\Pictures

# Local InsightFace buffalo_l pack (must already contain the .onnx files)
INSIGHTFACE_DIR=C:\Users\me\.insightface
